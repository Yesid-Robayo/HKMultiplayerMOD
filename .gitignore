# Binarios y datos del juego (propiedad de Team Cherry) y de la Modding API compilada: solo en local (los rehace
# tools/setup-dev.sh a partir del juego instalado)
lib/
vendor/
test-instances/

# Modding API (código en modding-api/, sí se sube): sin el juego ni lo que se genera al compilarla
modding-api/Vanilla/
modding-api/override/
modding-api/OutputFinal/
modding-api/*/Output/
modding-api/*/packages/
modding-api/Examples/HollowKnightManaged/

# Compilación y paquetes
out/
dist/
**/bin/
**/obj/
*.user
.vs/
.idea/

# Nunca subir claves, certificados ni ajustes con datos de la cuenta
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
*GlobalSettings*.json
.env

# Registros y temporales
*.log
ModLog.txt
__pycache__/
*.pyc

# Worktrees y datos locales de los agentes
.claude/

# Skins de prueba (de otros autores): solo en local
skins/
