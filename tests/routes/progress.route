shared guest brettaRescued true
shared guest slyRescued true
shared guest zoteRescuedBuzzer true

# ---- Del mundo, desde el host ----
shared host openedTownBuilding true
shared host jijiDoorUnlocked true
shared host openedSlyShop true
shared host visitedGreenpath true
shared host visitedRuins true
