private host geo 4321
private host nailDamage 17
private host charmSlots 6
private host gotCharm_2 true
private host hasWhiteKey true

# Al final los dos tienen el mismo mundo
same-pd hasDash
same-pd openedCityGate
same-pd killsBuzzer
same-pd fireballLevel

# Cambiar de sala no deshace nada
room Crossroads_01 left1
same-pd hasSuperDash
same-pd openedRoyalGardens
