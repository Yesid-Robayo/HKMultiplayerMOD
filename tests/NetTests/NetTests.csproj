<Project Sdk="Microsoft.NET.Sdk">
    <!-- Pruebas del transporte y la sesión fuera del juego: se compilan los mismos archivos de src/HKMultiplayer/Net y Session -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <RootNamespace>HKMultiplayer.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\src\HKMultiplayer\Net\**\*.cs" Link="Net\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\src\HKMultiplayer\Session\**\*.cs" Link="Session\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\..\src\HKMultiplayer\Game\Players\PlayerSnapshot.cs;..\..\src\HKMultiplayer\Game\Players\SnapshotBuffer.cs" Link="Game\%(Filename)%(Extension)" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    </ItemGroup>
</Project>
